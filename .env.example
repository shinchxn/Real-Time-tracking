# ── Content DNA v8.0 Apex — Required Environment Variables ────────────────────
# Copy this file to .env and fill in your values.
# v8.0: All paid API keys replaced with open-source alternatives.

# ── API & Security ──────────────────────────────────────────────────────────
API_KEY_SECRET=generate-a-secure-secret-here
FERNET_KEY=generate-a-fernet-key-for-sessions-here
DEBUG=false

# ── Database & Cache ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentdna
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Blockchain & Provenance ─────────────────────────────────────────────────
# v8.0: Use free polygon-rpc.com instead of paid Alchemy
POLYGON_RPC=https://polygon-rpc.com
CONTENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ZK_PROOF_DIR=./data/proofs

# ── Blockchain Vault (web3.py) ──────────────────────────────────────────────
WEB3_RPC_URL=https://polygon-rpc.com
CONTRACT_ADDRESS=
CHAIN_ID=137
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BLOCKCHAIN_KEY_ENCRYPTION_KEY=

# ── Hunting Grid (Google Dorking via pagodo — zero cost) ────────────────────
# v8.0: GOOGLE_CSE_API_KEY, GOOGLE_CSE_ID, SERPAPI_KEY removed — pagodo is free
DORK_MIN_DELAY=5.0        # seconds between dork queries (avoid rate limits)
DORK_MAX_DELAY=12.0
DORK_MAX_RESULTS=10       # results per query
DORK_PROXIES=             # optional: comma-separated proxy list
DORK_PROXY_FILE=          # optional: path to proxies.txt (one per line)

# ── Instagram Crawler ───────────────────────────────────────────────────────
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password
INSTAGRAM_SESSION_ENC=

# ── Reverse Image Search (v8.0: local CLIP+FAISS + SauceNAO free) ───────────
# v8.0: TINEYE_API_KEY, BING_VISUAL_SEARCH_KEY removed — replaced by local FAISS
SAUCENAO_API_KEY=    # free at saucenao.com — 300 searches/day with free key

# ── IPFS ────────────────────────────────────────────────────────────────────
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=http://localhost:5001

# ── AI & Forensic Backbone (v8.0: always local HuggingFace CLIP) ────────────
# v8.0: NVIDIA_API_KEY removed — local CLIP always used
# CPU  → auto-uses clip-vit-base-patch32  (512-dim, fast)
# CUDA → auto-uses clip-vit-large-patch14 (768-dim, accurate)
# Override auto-selection by setting CLIP_MODEL explicitly:
CLIP_MODEL=openai/clip-vit-base-patch32
MATCH_THRESHOLD=0.92
THRESHOLD_CRITICAL=0.96
THRESHOLD_HIGH=0.88
THRESHOLD_MEDIUM=0.75

# ── Watermark ───────────────────────────────────────────────────────────────
WATERMARK_MASTER_SEED=0xDEADBEEF
# Generate with: python -c "import secrets; print(secrets.randbits(32))"
WATERMARK_SEED=

# ── Multimedia Core ─────────────────────────────────────────────────────────
VIDEO_FPS=1
AUDIO_SR=22050
MAX_FILE_SIZE=524288000

# ── DMCA Evidence Generation ────────────────────────────────────────────────
DMCA_TEMPLATE_PATH=data/dmca_template.html
DMCA_SENDER_NAME=
DMCA_SENDER_EMAIL=
DMCA_AUTOMATION_ENABLED=true
EVIDENCE_DIR=./data/evidence

# ── Push Alerts via ntfy (v8.0: replaces Slack webhook) ─────────────────────
# v8.0: ALERT_WEBHOOK_URL (Slack) removed — replaced by ntfy (free, self-hosted)
# Self-host: docker run -p 80:80 binwiederhier/ntfy
# Or use public server: https://ntfy.sh
NTFY_URL=https://ntfy.sh           # or your self-hosted URL
NTFY_TOPIC=contentdna-alerts       # subscribe to this topic in the ntfy app
NTFY_TOKEN=                        # only needed for private self-hosted ntfy with auth

# ── Web Crawl Targets (comma-separated feed URLs) ────────────────────────────
WEB_CRAWL_TARGETS=
